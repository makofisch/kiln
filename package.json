{
  "name": "kiln",
  "productName": "Kiln",
  "version": "0.9.0",
  "private": true,
  "description": "Kiln: model in a headless Blender with an AI copilot and a live 3D viewer.",
  "author": "The Kiln authors",
  "license": "MIT",
  "type": "module",
  "main": "out/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "core": "node src/core/entry.ts",
    "dist": "node scripts/release.mjs",
    "icon": "node scripts/make-icon.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/test-login.ts && node scripts/test-zfight-gate.ts",
    "smoke": "node scripts/smoke-core.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "com.kiln.app",
    "productName": "Kiln",
    "copyright": "Copyright (c) 2026 The Kiln authors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/*.js",
      "out/*.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "blender",
        "to": "blender",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "out/renderer",
        "to": "renderer"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Kiln"
    },
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kiln",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": null
  }
}
